<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SeiPDFManagement</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

@{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<body class="@(controller != "Home" ? "has-navbar" : "")">

    @if (controller != "Home")
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm">
                <div class="container">
                    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                        SeiPDFManagement
                    </a>

                    <div class="collapse navbar-collapse">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        </ul>

                        <a class="nav-link" href="/swagger">Swagger</a>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer border-top text-muted">
        <div class="container">
            &copy; 2026 – SeiPDFManagement
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
